{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Ark Artwork resource pack v1",
 "type": "object",
 "required": ["schemaVersion", "packID", "version", "models", "backgrounds", "files"],
 "properties": {
  "schemaVersion": {"const": 1}, "packID": {"type": "string", "minLength": 1},
  "version": {"type": "integer", "minimum": 1}, "totalBytes": {"type": "integer", "minimum": 0},
  "models": {"type": "array", "minItems": 1, "items": {
   "type": "object", "required": ["id", "name", "outfit", "kind", "mediaType"],
   "properties": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{16}$"}, "name": {"type": "string"}, "outfit": {"type": "string"}, "kind": {"type": "string"},
    "mediaType": {"enum": ["image", "spine"]}, "image": {"$ref": "#/$defs/path"}, "atlas": {"$ref": "#/$defs/path"}, "skeleton": {"$ref": "#/$defs/path"},
    "skeletonFormat": {"enum": ["json", "binary"]},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "alphaMode"], "properties": {"path": {"$ref": "#/$defs/path"}, "alphaMode": {"enum": ["straight", "pma"]}}}}
   },
   "allOf": [{"if": {"properties": {"mediaType": {"const": "image"}}}, "then": {"required": ["image"]}, "else": {"required": ["atlas", "skeleton", "skeletonFormat", "pages"]}}]
  }},
  "backgrounds": {"type": "array", "items": {"type": "object", "required": ["id", "name", "images"], "properties": {"id": {"type": "string"}, "name": {"type": "string"}, "images": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/path"}}}}},
  "files": {"type": "array", "items": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}
 },
 "$defs": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"}}
}
